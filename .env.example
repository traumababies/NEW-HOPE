# Example local environment — copy to .env and fill in real values.
# NEVER commit the real .env.

APP_ENV=development
ADMIN_EMAIL=jean@evoluebeauty.com
SESSION_SECRET=

# Azure SQL (free-the-information-101010 / sanctuary-888)
SQL_SERVER=
SQL_DATABASE=sanctuary-888
SQL_USERNAME=
SQL_PASSWORD=

# Azure Blob (godzilla1126)
AZURE_BLOB_ACCOUNT=godzilla1126
AZURE_BLOB_KEY=
# One container per role:
CONTAINER_BUNBUNS=bunbuns
CONTAINER_EPHEMERA=ephemera
CONTAINER_SCRAPPA=magic-carpet

# AI
OLLAMA_ENABLED=false
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
GROQ_API_KEY=
GROQ_MODEL=

# Content Scout providers
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
COVERR_API_KEY=
